---
import background from '@/assets/background.jpeg';
import portrait from '@/assets/portrait.jpg';
import ContentCard from '@/components/ContentCard.astro';
import ListCard, { type ListItem } from '@/components/ListCard.astro';

const circle = `<svg fill="currentColor" class="inline-block h-2 w-2 align-middle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle></svg>`;

const experienceData: ListItem[] = [
  {
    title: 'Sanacorp Pharmahandel GmbH',
    name: `Remote Contract ${circle} Munich, Germany ${circle} Oct 2024 - present`,
    content: `Contributing to the development and modernization of an enterprise procurement and supply-chain management system responsible for demand forecasting, inventory control, inter-location stock transfers, and automated order generation with suppliers. Supporting the transition to a new, more robust platform with improved functionality, maintainability, and overall software quality.`,
    labels: ['Java', 'Wildfly', 'Oracle DB', 'Redwood', 'Java FX', 'Java Swing', 'Gradle'],
  },
  {
    title: 'DATA SWEEP',
    name: `Co-founder ${circle} Cluj-Napoca, Romania ${circle} Mar 2024 - present`,
    content: `Worked on validating the business model through multiple startup accelerator programs and winning some of them throughout the past year; developed the front-end of our platform using the newest technologies`,
    labels: ['Next.js', 'Typescript', 'Tailwind', 'Knowledge Graphs', 'Semantic Search', 'Keycloak', 'DevOps'],
  },
  {
    title: 'Ciconia Systems GmbH',
    name: `Remote ${circle} Mannheim, Germany ${circle} Feb 2023 - present`,
    content: `Worked on the implementation of <a href='https://vergabepilot.ai' class='font-medium  hover:underline' target='_blank'>Vergabepilot</a>, a project that crawls the web for public tenders, ranks them based on the similarity to a predefined list of tenders, then extracts relevant information from the tender's published documents.`,
    labels: ['Java', 'Spring Boot', 'React Native', 'Next.js', 'Typescript', 'Tailwind', 'Keycloak'],
  },
];

const educationData: ListItem[] = [
  {
    title: 'Software Engineering M.Sc.',
    name: `University of Bucharest ${circle} Oct 2024 - Jun 2026`,
    content: `Contributing to the development and modernization of an enterprise procurement and supply-chain management system responsible for demand forecasting, inventory control, inter-location stock transfers, and automated order generation with suppliers. Supporting the transition to a new, more robust platform with improved functionality, maintainability, and overall software quality.`,
  },
  {
    title: 'Computer Science B.Sc.',
    name: `TU Berlin & Babeș-Bolyai University, Cluj-Napoca ${circle} Sep 2021 - Jun 2024`,
    content: `Worked on validating the business model through multiple startup accelerator programs and winning some of them throughout the past year; developed the front-end of our platform using the newest technologies`,
  },
  {
    title: 'AWS Developer Associate',
    name: `Issued by Amazon Web Services ${circle} Jul 2023`,
  },
  {
    title: 'Deutsches Sprachdiplom (C1)',
    name: `Issued by Auswärtiges Amt ${circle} Mar 2021`,
  },
  {
    title: 'Cambridge English: Advanced (C1)',
    name: `Issued by Cambridge English ${circle} Jun 2019`,
  },
];

const languagesData: ListItem[] = [
  {
    title: 'German',
    name: 'Full professional proficiency - CEFR level C1',
  },
  {
    title: 'English',
    name: 'Full professional proficiency - CEFR level C1',
  },
  {
    title: 'Romanian',
    name: 'Native speaker',
  },
  {
    title: 'French',
    name: 'Un peu',
  },
];

const projectsData: ListItem[] = [
  {
    title: 'Fitranker',
    content: `Rank CVs for a job position based on the similarity to the job description. Early work in embeddings and semantic search. Next.js based frontend with a Java Spring backend `,
    labels: [
      'Java',
      'Spring Boot',
      'Milvus Vector DB',
      'OpenAI',
      'Next.js',
      'Typescript',
      'Shadcn UI',
      'Tailwind',
      'Keycloak',
    ],
  },
  {
    title: '<a href="https://github.com/galitianu/www" target="_blank" class="hover:underline">This website</a>',
    content: `My first foray into Astro, a framework for building fast static websites. Great experience, will continue to use it for my future projects.`,
    labels: ['Astro', 'Typescript', 'Shadcn UI', 'Tailwind'],
  },
  {
    title:
      '<a href="https://www.uni-mannheim.de/ines/lehre/european-master-team-project/projekt-lunatic-driving-ai/" target="_blank" class="hover:underline">Lunatic Driver AI</a>',
    content: `Simulated cars driving on the highway in a normal or lunatic manner. The AI was based on a comprehensive set of rules that allow customizable driving behavior.`,
    labels: ['CARLA Simulator', 'Python', 'TensorFlow', 'NumPy', 'Pandas'],
  },
  {
    title: '',
    content: `<a class="underline" href="/projects">See all</a>`,
  },
];
---

<div class='relative min-h-dvh w-full'>
  <img src={background.src} alt='Background' class='fixed inset-0 -z-10 h-full w-full object-cover' />

  <div class='flex flex-col items-center justify-center space-y-12 overflow-x-hidden pb-16'>
    <div
      class='container mx-auto flex h-[calc(100dvh-3.5rem)] w-full flex-col items-center justify-end space-y-4 px-4 pb-8'
    >
      <div class='flex w-full grid-cols-1 flex-col-reverse gap-8 md:grid md:grid-cols-[3fr_2fr] md:gap-12'>
        <div class='w-full space-y-4 text-center md:text-right'>
          <h1 class='text-8xl font-bold'>Andrei<br />Galitianu</h1>
          <span
            class='text-right text-xl font-semibold'
            set:html={`Software Engineer ${circle} Backend & Web Systems`}
          />
        </div>
        <div class='my-auto flex items-center justify-center'>
          <img
            src={portrait.src}
            alt='Andrei Galitianu'
            class='aspect-square h-48 w-48 rounded-full object-cover md:h-60 md:w-60'
          />
        </div>
      </div>
    </div>

    <div
      class='via-background/30 to-background/30 -mt-32 w-full bg-gradient-to-b from-transparent pt-36 pb-12 backdrop-blur-xl'
      style='mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 100%);'
    >
      <div
        class='container mx-auto space-y-12 px-4 md:grid md:grid-cols-[auto_1fr_20vw] md:space-y-0 md:gap-x-4 md:gap-y-12'
      >
        <ContentCard title='About'>
          <span
            >Software Engineer with 3 years of experience building and operating scalable applications across enterprise
            and startup environments. I specialize in Java, Spring Boot, and modern web technologies such as Next.js and
            TypeScript. <br />I enjoy working at the intersection of backend systems, integrations, and clean UI
            development. <br /><br />My work ranges from modernizing large-scale procurement and supply-chain systems to
            building search and knowledge-driven products using semantic technologies. As a co-founder, I’ve also worked
            hands-on in validating business ideas, delivering production-ready features, and shaping technical product
            strategy. <br /><br />I'm passionate about reliable software, thoughtful architecture, and tools that make
            people's lives easier.</span
          >
        </ContentCard>

        <ListCard title='Experience' items={experienceData} />

        <ListCard title='Education & Certifications' items={educationData} />

        <ListCard title='Languages' items={languagesData} />

        <ListCard title='Projects' items={projectsData} />

        <ContentCard title='Links'>
          <div class='md:col-span-full'>
            I prefer being contacted by email. <div class='flex gap-2'>
              <a class='underline' href='mailto:andrei@galitianu.com'>Email</a>
              <a class='underline' href='https://www.linkedin.com/in/galitianu' target='_blank'>LinkedIn</a>
              <a class='underline' href='https://github.com/galitianu' target='_blank'>GitHub</a>
            </div><br />
            On a more personal note: <div class='flex gap-2'>
              <a class='underline' href='https://letterboxd.com/galitianu/films/' target='_blank'>Letterboxd</a>
              <a class='underline' href='https://www.discogs.com/user/galitianu/collection' target='_blank'>Discogs</a>
            </div>
          </div>
        </ContentCard>
      </div>
    </div>
    <div class='bg-background/30 w-full py-12 backdrop-blur-xl'>
      <div class='container mx-auto px-4 pb-[30vh] text-left text-8xl font-semibold'>
        Let's create <br />something<br />remarkable!
      </div>
    </div>
  </div>
</div>
